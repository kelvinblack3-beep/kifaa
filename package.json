{
  "name": "kifaa",
  "version": "0.1.0",
  "private": true,
  "description": "KIFAA — Kenya-first financial interface & orchestration platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm run --parallel dev:api dev:web",
    "dev:api": "pnpm --filter @kifaa/api dev",
    "dev:web": "pnpm --filter @kifaa/web dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:ledger": "pnpm --filter @kifaa/ledger test",
    "db:generate": "pnpm --filter @kifaa/database generate",
    "db:migrate": "pnpm --filter @kifaa/database migrate",
    "db:studio": "pnpm --filter @kifaa/database studio",
    "format": "prettier --write .",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
