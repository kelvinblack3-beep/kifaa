# KIFAA Environment Configuration
# Copy to .env and fill values. NEVER commit real secrets.

NODE_ENV=development
APP_NAME=kifaa
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=/v1

# PostgreSQL
DATABASE_URL=postgresql://kifaa:kifaa_dev@localhost:5432/kifaa
POSTGRES_USER=kifaa
POSTGRES_PASSWORD=kifaa_dev
POSTGRES_DB=kifaa

# Redis
REDIS_URL=redis://localhost:6379

# Auth / Crypto
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_SECRET=change-me-to-another-long-random-string
PIN_HASH_MEMORY_COST=65536
PIN_HASH_TIME_COST=3

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Provider credentials (leave empty until real integration)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_ENV=sandbox

# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=
# AIRTEL_ENV=sandbox

# SMS provider (CPaaS) — abstract; configure later
# SMS_PROVIDER=
# SMS_API_KEY=

# Feature flags
ENABLE_SANDBOX_PROVIDERS=true
ENABLE_USSD=true
